{
  "name": "lda-graph",
  "private": true,
  "version": "1.0.1",
  "description": "LDA Local Graph \u2014 local development stand-in compatible with Optimizely Graph. Part of Local Developer Accelerator for Optimizely by Coding Koala. Development use only.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 install",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 uninstall",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 status",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 restart",
    "service:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 logs",
    "release:build": "node scripts/build-release.mjs"
  },
  "keywords": [],
  "author": "Coding Koalas Pty Ltd",
  "license": "BUSL-1.1",
  "repository": "github:coding-koala-io/lda-graph",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "jszip": "3.10.1"
  },
  "homepage": "https://github.com/coding-koala-io/lda-graph#readme"
}
