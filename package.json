{
  "name": "lda-graph",
  "private": true,
  "version": "1.2.3",
  "description": "LDA Local Graph: a local Graph service for development, compatible with Optimizely CMS 13. Part of Local Developer Accelerator. Free and open source (Apache 2.0). Development use only. Not affiliated with or endorsed by Optimizely. Built by Coding Koala.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 install",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 uninstall",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 status",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 restart",
    "service:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 logs",
    "release:build": "node scripts/build-release.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [],
  "author": "Coding Koalas Pty Ltd (https://codingkoala.io)",
  "license": "Apache-2.0",
  "repository": "github:coding-koala-io/lda-graph",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "mammoth": "1.12.3",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "jszip": "3.10.1"
  },
  "homepage": "https://github.com/coding-koala-io/lda-graph#readme",
  "bugs": "https://github.com/coding-koala-io/lda-graph/issues"
}
